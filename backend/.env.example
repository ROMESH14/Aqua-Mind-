DB_DRIVER=sqlite
PORT=5005
JWT_SECRET=your_secret_key_here_change_this
AI_ENGINE_URL=http://localhost:5001

# SQLite (default) — file is created automatically at backend/data/aquamind.db
# SQLITE_PATH=./data/aquamind.db

# MySQL / phpMyAdmin (set DB_DRIVER=mysql)
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_DATABASE=aquamind

# SQL Server (set DB_DRIVER=mssql)
# DB_SERVER=localhost\\SQLEXPRESS
# DB_DATABASE=AquaMindDB
# DB_TRUSTED_CONNECTION=true
